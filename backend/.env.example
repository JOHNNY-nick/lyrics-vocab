# Copier ce fichier en .env (jamais commité) et remplir les valeurs (annexe 2).
# Secrets
DATABASE_URL=postgresql+psycopg://postgres:MOT_DE_PASSE@127.0.0.1:5432/lyrics_vocab
MUSIXMATCH_API_KEY=
GENIUS_TOKEN=
DEEPL_API_KEY=

# Services locaux
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Dossiers (ENV-04)
STATIC_DIR=C:/lyrics-vocab/depot/app/build/web
APK_DIR=C:/lyrics-vocab/apk
LOG_DIR=C:/lyrics-vocab/logs
BACKUP_DIR=C:/lyrics-vocab/sauvegardes

# Fuseau du PC (nom IANA), utilisé quand l'appareil n'envoie pas X-Fuseau (ALG-15)
FUSEAU_PC=Europe/Paris

# Quotas (valeurs à confirmer à la phase 03)
QUOTA_MUSIXMATCH_JOUR=2000
QUOTA_GENIUS_JOUR=1000
QUOTA_DEEPL_MOIS=500000

# Paramètres (26.2) — valeurs par défaut, à décommenter pour les changer
# ENRICHISSEMENT_PARALLELE=2
# ENRICHISSEMENT_REPRISE_MIN=10
# RECHERCHE_DUREE_MAX_S=30
# MORCEAUX_PAR_ARTISTE=25
# MORCEAUX_REPLI=10
# HTTP_TIMEOUT_S=10
# IA_TIMEOUT_S=30
# IA_MAX_JETONS=150
# QUOTA_ALERTE_PCT=80
# DISJONCTEUR_ECHECS=5
# DISJONCTEUR_PAUSE_MIN=5
# LIMITE_REQUETES_MIN=60
# SYNC_PAGE=200
# SYNC_LOT=50
# JOURNAL_TAILLE_MO=10
# JOURNAL_FICHIERS=14
# SAUVEGARDE_JOURS=14
# NIVEAU_ACQUIS_JOURS=21
# INTERVALLE_MAX_JOURS=365
# MODE=production
